<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <property name="LOG_PATH" value="D:/rizi"/>
    <!-- 日志格式：时间 [TraceId] [线程] 级别 Logger - 消息 -->
    <!-- %X{trace_id} 引用 MDC 中的 TraceId，由 TraceIdFilter 设置 -->
    <property name="LOG_PATTERN" value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%X{trace_id:-no-trace}] [%thread] %-5level %logger{36} - %msg%n"/>

    <!-- 控制台输出 Appender - 接收所有级别日志，使用 GBK 编码适配 Windows -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>GBK</charset>
        </encoder>
    </appender>

    <!-- INFO 日志 Appender：只接收 INFO 级别日志 -->
    <appender name="INFO_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/info.log</file>
        <createDirs>true</createDirs>
        <cleanHistoryOnStart>true</cleanHistoryOnStart>
        <!-- 只接收 INFO 级别，过滤掉 DEBUG 和 WARN/ERROR -->
        <filter class="ch.qos.logback.classic.filter.LevelFilter">
            <level>INFO</level>
            <onMatch>ACCEPT</onMatch>
            <onMismatch>DENY</onMismatch>
        </filter>
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/info-%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>5GB</totalSizeCap>
        </rollingPolicy>
    </appender>

    <!-- WARN 日志 Appender：只接收 WARN 级别日志 -->
    <appender name="WARN_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/warn.log</file>
        <createDirs>true</createDirs>
        <cleanHistoryOnStart>true</cleanHistoryOnStart>
        <filter class="ch.qos.logback.classic.filter.LevelFilter">
            <level>WARN</level>
            <onMatch>ACCEPT</onMatch>
            <onMismatch>DENY</onMismatch>
        </filter>
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/warn-%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>5GB</totalSizeCap>
        </rollingPolicy>
    </appender>

    <!-- ERROR 日志 Appender：只接收 ERROR 级别日志 -->
    <appender name="ERROR_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/error.log</file>
        <createDirs>true</createDirs>
        <cleanHistoryOnStart>true</cleanHistoryOnStart>
        <filter class="ch.qos.logback.classic.filter.LevelFilter">
            <level>ERROR</level>
            <onMatch>ACCEPT</onMatch>
            <onMismatch>DENY</onMismatch>
        </filter>
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/error-%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>5GB</totalSizeCap>
        </rollingPolicy>
    </appender>

    <!-- DEBUG 镜像 Appender：完整镜像控制台输出（com.algoviz 全级别 + root INFO 级），
         用于本地排障时把控制台内容同步落盘到 DEBUG.txt。
         append="false"：每次应用启动自动截断重置该文件（与"控制台每次启动清空"行为一致）。 -->
    <appender name="DEBUG_FILE" class="ch.qos.logback.core.FileAppender">
        <file>${LOG_PATH}/DEBUG.txt</file>
        <createDirs>true</createDirs>
        <append>false</append>
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- ============================================================
         JDK 内置 java.util.logging(JUL) 桥接类别配置（jul-to-slf4j 已由 starter-logging 提供）
         这些 logger 名 = JDK 内部 JUL logger 名，由 SLF4JBridgeHandler 转发到 logback：
             SEVERE -> ERROR、WARNING -> WARN、INFO -> INFO、FINE -> DEBUG
         统一设 WARN：只放行 WARNING/SEVERE（JUL 的 INFO/低级别噪音被过滤），
         并继承 root 的 appender（控制台 / DEBUG.txt / 分级文件）输出。
         ============================================================
         覆盖的常见输出来源：
           - sun.net / java.net      : HttpURLConnection、DNS 解析、NIO/Socket
           - javax.net / javax.net.ssl: SSL 握手、证书告警
           - java.security / sun.security / javax.security: 加密算法、证书策略
           - com.sun.org.apache      : JDK 内置 JAXP/Xerces/Xalan（XML 解析告警）
           - org.jcp                 : XML 数字签名（JSR105）
           - jdk.module              : 模块系统访问告警
         注意：个别 JDK 提示（如 Illegal reflective access）由 JVM 直接写 stderr，
               不经 JUL，无法被 logback 接管，仅会出现在控制台。
         ============================================================ -->
    <logger name="sun.net" level="WARN"/>
    <logger name="java.net" level="WARN"/>
    <logger name="javax.net" level="WARN"/>
    <logger name="java.security" level="WARN"/>
    <logger name="javax.security" level="WARN"/>
    <logger name="sun.security" level="WARN"/>
    <logger name="com.sun.org.apache" level="WARN"/>
    <logger name="org.jcp" level="WARN"/>
    <logger name="jdk.module" level="WARN"/>

    <!-- Spring Profile 配置 - 开发环境 -->
    <springProfile name="!prod">
        <!--
            com.algoviz 包配置：
            - level="DEBUG": 控制台显示 DEBUG 及以上级别日志
            - additivity="false": 日志不传递到 root logger，避免重复
            - CONSOLE: 接收所有级别日志（DEBUG 及以上）
            - INFO_FILE: 只接收 INFO 级别（通过 filter 控制）
            - WARN_FILE: 只接收 WARN 级别
            - ERROR_FILE: 只接收 ERROR 级别
        -->
        <logger name="com.algoviz" level="DEBUG" additivity="false">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="DEBUG_FILE"/>
            <appender-ref ref="INFO_FILE"/>
            <appender-ref ref="WARN_FILE"/>
            <appender-ref ref="ERROR_FILE"/>
        </logger>

        <!-- root logger: 其他包的日志只输出到控制台和 ERROR_FILE -->
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="DEBUG_FILE"/>
            <appender-ref ref="ERROR_FILE"/>
        </root>
    </springProfile>

    <!-- Spring Profile 配置 - 生产环境 -->
    <springProfile name="prod">
        <!--
            生产环境：
            - 控制台不输出 DEBUG 日志
            - 文件只收集相应级别的日志
        -->
        <logger name="com.algoviz" level="INFO" additivity="false">
            <appender-ref ref="INFO_FILE"/>
            <appender-ref ref="WARN_FILE"/>
            <appender-ref ref="ERROR_FILE"/>
        </logger>

        <root level="INFO">
            <appender-ref ref="INFO_FILE"/>
            <appender-ref ref="ERROR_FILE"/>
        </root>
    </springProfile>

</configuration>
