<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.algoviz.mapper.OJProblemMapper">

    <resultMap id="ProblemResultMap" type="com.algoviz.entity.OJProblem">
        <id property="id" column="id"/>
        <result property="problemNo" column="problem_no"/>
        <result property="title" column="title"/>
        <result property="difficulty" column="difficulty"/>
        <result property="tags" column="tags"/>
        <result property="description" column="description"/>
        <result property="template" column="template"/>
        <result property="status" column="status"/>
        <result property="submissionCount" column="submission_count"/>
        <result property="acRate" column="ac_rate"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <!-- 动态查询方法：支持排序、分页、筛选 -->
    <select id="selectByCondition" resultMap="ProblemResultMap">
        SELECT * FROM oj_problem
        <where>
            <if test="keyword != null and keyword != ''">
                AND (title LIKE CONCAT('%', #{keyword}, '%') 
                     OR tags LIKE CONCAT('%', #{keyword}, '%') 
                     OR problem_no LIKE CONCAT('%', #{keyword}, '%'))
            </if>
            <if test="difficulty != null and difficulty != ''">
                AND difficulty = #{difficulty}
            </if>
            <if test="status != null and status != ''">
                AND status = #{status}
            </if>
        </where>
        <!-- 动态排序：使用 ${} 因为排序字段名不能使用预编译参数 -->
        <choose>
            <when test="sortBy == 'createdAt'">
                ORDER BY created_at ${sort}
            </when>
            <when test="sortBy == 'problemNo'">
                ORDER BY problem_no ${sort}
            </when>
            <otherwise>
                ORDER BY id ${sort}
            </otherwise>
        </choose>
        LIMIT #{offset}, #{limit}
    </select>

    <!-- 动态统计方法：获取符合条件的总记录数 -->
    <select id="countByCondition" resultType="int">
        SELECT COUNT(*) FROM oj_problem
        <where>
            <if test="keyword != null and keyword != ''">
                AND (title LIKE CONCAT('%', #{keyword}, '%') 
                     OR tags LIKE CONCAT('%', #{keyword}, '%') 
                     OR problem_no LIKE CONCAT('%', #{keyword}, '%'))
            </if>
            <if test="difficulty != null and difficulty != ''">
                AND difficulty = #{difficulty}
            </if>
            <if test="status != null and status != ''">
                AND status = #{status}
            </if>
        </where>
    </select>

</mapper>
