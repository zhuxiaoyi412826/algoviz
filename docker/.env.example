# ====== AlgoViz Docker 环境变量 ======
# 使用方法：cp .env.example .env  然后填入真实值
# .env 文件禁止入库（已在 .gitignore / .dockerignore）

# ---------- MySQL ----------
# MYSQL_ROOT_PASSWORD 被 compose 的 mysql.environment 和 healthcheck 引用，不能缺
MYSQL_ROOT_PASSWORD=${MYSQL_ROOT_PASSWORD}
# backend 用 root 连库（mysql 服务已设 MYSQL_ROOT_HOST='%' 允许远程 root）
MYSQL_USER=root
MYSQL_PASSWORD=${MYSQL_ROOT_PASSWORD}

# ---------- DeepSeek ----------
DEEPSEEK_API_KEY=${DEEPSEEK_API_KEY}

# ---------- 微信公众号 ----------
WECHAT_TOKEN=${WECHAT_TOKEN}
WECHAT_APPID=${WECHAT_APPID}
WECHAT_APPSECRET=${WECHAT_APPSECRET}
WECHAT_ENCODING_AES_KEY=${WECHAT_ENCODING_AES_KEY}

# ---------- 微信支付 ----------
WECHAT_PAY_APPID=${WECHAT_PAY_APPID}
WECHAT_PAY_MCH_ID=${WECHAT_PAY_MCH_ID}
WECHAT_PAY_MCH_SHORTNAME=${WECHAT_PAY_MCH_SHORTNAME}
WECHAT_PAY_API_V3_KEY=${WECHAT_PAY_API_V3_KEY}
WECHAT_PAY_CERT_SERIAL_NO=${WECHAT_PAY_CERT_SERIAL_NO}
